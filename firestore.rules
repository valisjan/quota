rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticat() {
      return request.auth != null;
    }

    function usuari() {
      return get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data;
    }

    function rolUsuari() {
      return usuari().rol;
    }

    function departamentUsuari() {
      return usuari().departament;
    }

    function departamentsUsuari() {
      return usuari().departaments is list ? usuari().departaments : [];
    }

    function departamentsPreautoritzats(email) {
      return preautoritzat(email).departaments is list
        ? preautoritzat(email).departaments
        : (
          preautoritzat(email).departament is string
          ? [preautoritzat(email).departament]
          : []
        );
    }

    function departamentPreautoritzat(email) {
      return preautoritzat(email).departament != null
        ? preautoritzat(email).departament
        : (
          departamentsPreautoritzats(email).size() > 0
          ? departamentsPreautoritzats(email)[0]
          : null
        );
    }

    function esAdmin() {
      return autenticat() && rolUsuari() == 'admin';
    }

    function esCap() {
      return autenticat() && rolUsuari() in ['admin', 'cap_departament', 'departament'];
    }

    function preautoritzat(email) {
      return exists(/databases/$(database)/documents/preautoritzats/$(email))
        ? get(/databases/$(database)/documents/preautoritzats/$(email)).data
        : null;
    }

    function createUsuariValid(uid) {
      return autenticat()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          !('rol' in request.resource.data)
          || (
            request.resource.data.rol == null
            && request.resource.data.departament == null
            && (
              !('departaments' in request.resource.data)
              || request.resource.data.departaments == []
            )
          )
          || (
            preautoritzat(request.resource.data.email) != null
            && request.resource.data.rol == preautoritzat(request.resource.data.email).rol
            && request.resource.data.departament == departamentPreautoritzat(request.resource.data.email)
            && request.resource.data.departaments == departamentsPreautoritzats(request.resource.data.email)
          )
        );
    }

    function updateUsuariPreautoritzatValid(uid) {
      return autenticat()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && preautoritzat(request.auth.token.email) != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rol', 'departament', 'departaments', 'updatedAt'])
        && request.resource.data.rol == preautoritzat(request.auth.token.email).rol
        && request.resource.data.departament == departamentPreautoritzat(request.auth.token.email)
        && request.resource.data.departaments == departamentsPreautoritzats(request.auth.token.email);
    }

    function esClasseDelDepartament(data) {
      return data.departament == departamentUsuari()
        || data.departament in departamentsUsuari()
        || (
          data.departaments is list
          && (
            departamentUsuari() in data.departaments
            || data.departaments.hasAny(departamentsUsuari())
          )
        );
    }

    function esProfessorDelDepartament(data) {
      return data.departament == departamentUsuari()
        || data.departament in departamentsUsuari()
        || (
          data.departaments is list
          && (
            departamentUsuari() in data.departaments
            || data.departaments.hasAny(departamentsUsuari())
          )
        );
    }

    function canvisAssignacioClasse() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'professors',
        'professorAssignat',
        'participants',
        'lastModified'
      ]);
    }

    function canvisParticipantsCoordinacio() {
      return resource.data.tipus == 'C'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants',
          'lastModified'
        ]);
    }

    function canvisProfessorDepartament() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'gpAssignades',
        'gcAssignades',
        'palicAssignades',
        'sdAssignades',
        'sdAssignacions',
        'ddAssignades',
        'ddAssignacions',
        'preferencia',
        'motiuAllegat',
        'comentaris',
        'lastModified'
      ]);
    }

    // Coleccions antigues: la dada bona viu dins de /cursos/{cursId}/...
    match /classes/{id} {
      allow read, write: if false;
    }

    match /professors/{id} {
      allow read, write: if false;
    }

    match /departaments/{id} {
      allow read, write: if false;
    }

    match /cursos/{cursId} {
      allow read: if autenticat();
      allow write: if esAdmin();

      match /classes/{id} {
        allow read: if autenticat();
        allow create, delete: if esAdmin();
        allow update: if esAdmin()
          || (
            esCap()
            && (
              (esClasseDelDepartament(resource.data) && canvisAssignacioClasse())
              || canvisParticipantsCoordinacio()
            )
          );
      }

      match /professors/{id} {
        allow read: if autenticat();
        allow create, delete: if esAdmin();
        allow update: if esAdmin()
          || (esCap() && esProfessorDelDepartament(resource.data) && canvisProfessorDepartament());
      }

      match /departaments/{id} {
        allow read: if autenticat();
        allow create, delete: if esAdmin();
        allow update: if esAdmin()
          || (
            esCap()
            && (
              resource.data.nom == departamentUsuari()
              || resource.data.nom in departamentsUsuari()
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['tancat', 'tancatPer', 'tancatAt'])
          );
      }

      match /config/{id} {
        allow read: if autenticat();
        allow write: if esAdmin();
      }

      // Còpia del professorat i els permisos abans de cada sincronització (per desfer-la).
      match /sync_backups/{id} {
        allow read, write: if esAdmin();
      }

      match /untis/{id} {
        allow read: if esAdmin();
        allow create, update: if esAdmin()
          && id == 'gestib_xml'
          && request.resource.data.keys().hasOnly([
            'xml',
            'nom',
            'mida',
            'anyGestib',
            'centreGestib',
            'updatedAt'
          ])
          && request.resource.data.xml is string
          && request.resource.data.xml.size() <= 750 * 1024
          && request.resource.data.nom is string
          && request.resource.data.nom.size() <= 180
          && request.resource.data.mida is int
          && request.resource.data.mida <= 750 * 1024
          && request.resource.data.anyGestib is string
          && request.resource.data.anyGestib.size() <= 20
          && request.resource.data.centreGestib is string
          && request.resource.data.centreGestib.size() <= 40
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /guardies/{id} {
        allow read: if esAdmin() || esCap() || rolUsuari() == 'professor';
        allow create, update: if esAdmin()
          && (
            (
              id in ['reference', 'untis', 'duties']
              && request.resource.data.keys().hasOnly([
                'kind',
                'name',
                'size',
                'text',
                'encoding',
                'updatedAt'
              ])
              && request.resource.data.kind == id
              && request.resource.data.name is string
              && request.resource.data.name.size() <= 180
              && request.resource.data.size is int
              && request.resource.data.size <= 850 * 1024
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 850 * 1024
              && request.resource.data.encoding == 'utf-8'
              && request.resource.data.updatedAt == request.time
            )
            || (
              id == 'convivencia'
              && request.resource.data.keys().hasOnly([
                'assignacions',
                'updatedAt'
              ])
              && request.resource.data.assignacions is map
              && request.resource.data.updatedAt == request.time
            )
            || (
              id == 'pati'
              && request.resource.data.keys().hasOnly([
                'schemaVersion',
                'startYear',
                'courseStart',
                'courseEnd',
                'zones',
                'customHolidays',
                'weekdayTeachers',
                'updatedAt'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.startYear is int
              && request.resource.data.courseStart is string
              && request.resource.data.courseEnd is string
              && request.resource.data.zones is list
              && request.resource.data.customHolidays is list
              && request.resource.data.weekdayTeachers is map
              && request.resource.data.updatedAt == request.time
            )
            || (
              id == 'stats'
              && request.resource.data.keys().hasOnly(['counts', 'guardHistory', 'guardHistoryVersion', 'updatedAt'])
              && request.resource.data.counts is map
              && (!('guardHistory' in request.resource.data) || request.resource.data.guardHistory is map)
              && (!('guardHistoryVersion' in request.resource.data) || request.resource.data.guardHistoryVersion is int)
              && request.resource.data.updatedAt == request.time
            )
            || (
              id == 'directoriVersion'
              && request.resource.data.keys().hasOnly(['version', 'updatedAt', 'updatedBy'])
              && request.resource.data.version is int
              && request.resource.data.updatedAt == request.time
              && request.resource.data.updatedBy is string
              && request.resource.data.updatedBy.size() <= 320
            )
          );
        allow delete: if esAdmin();
      }

      match /guardiesDays/{date} {
        allow read: if esAdmin()
          || ((esCap() || rolUsuari() == 'professor') && resource.data.status in ['published', 'closed']);
        allow create, update: if esAdmin()
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'date', 'status', 'absenceIds', 'assignments',
            'comments', 'groupsOut', 'groupTeachers', 'groupReleasedTeachers', 'partialGroups', 'outingAbsenceIds', 'cancelledAssignments',
            'overriddenCoTeacherAssignments',
            'publishedAt', 'closedAt', 'countedAssignments', 'clientUpdatedAt',
            'revision', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.date == date
          && request.resource.data.status in ['draft', 'published', 'closed']
          && request.resource.data.absenceIds is list
          && request.resource.data.assignments is map
          && request.resource.data.comments is map
          && request.resource.data.groupsOut is list
          && request.resource.data.groupTeachers is map
          && request.resource.data.groupReleasedTeachers is map
          && request.resource.data.partialGroups is list
          && request.resource.data.outingAbsenceIds is list
          && request.resource.data.cancelledAssignments is list
          && (
            !('overriddenCoTeacherAssignments' in request.resource.data)
            || request.resource.data.overriddenCoTeacherAssignments is list
          )
          && request.resource.data.publishedAt is string
          && request.resource.data.closedAt is string
          && request.resource.data.countedAssignments is list
          && request.resource.data.clientUpdatedAt is string
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        // Historial: la versió que cada canvi substitueix, a 30 posicions fixes
        // (v00-v29) que es reutilitzen. Només la gestió la veu i l'escriu. Es
        // desa a la mateixa transacció que el canvi, i per això no pot exigir
        // camps que una jornada antiga potser no té: si fallés, no es podria desar.
        match /versions/{slot} {
          allow read: if esAdmin();
          allow create, update: if esAdmin()
            && slot.matches('v[0-2][0-9]')
            && request.resource.data.get('date', date) == date
            && request.resource.data.replacedAt == request.time
            && request.resource.data.replacedBy is string
            && request.resource.data.replacedBy.size() <= 320;
          allow delete: if false;
        }
      }

      // Projecció mínima per a pantalles en mode quiosc. No conté fitxers
      // d'Untis, recomptes ni configuració interna de Guàrdies.
      match /guardiesPublicDays/{date} {
        // Les escriptures només admeten projeccions publicades o tancades.
        // Permetre el get d'una data inexistent evita convertir "no publicada"
        // en un error de permisos al quiosc.
        allow read: if true;
        allow create, update: if esAdmin()
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'courseId', 'date', 'status', 'revision',
            'publishedAt', 'clientUpdatedAt', 'hours', 'groupsOut', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.courseId == cursId
          && request.resource.data.date == date
          && request.resource.data.status in ['published', 'closed']
          && request.resource.data.hours is list
          && request.resource.data.groupsOut is list
          && request.resource.data.updatedAt == request.time;
        allow delete: if esAdmin();
      }

      match /sync_history/{id} {
        allow read, write: if esAdmin();
      }

      match /presence/{id} {
        allow read, write: if autenticat();
      }
    }

    match /usuaris/{uid} {
      allow read: if autenticat() && (request.auth.uid == uid || esAdmin());
      allow create: if createUsuariValid(uid);
      allow update: if esAdmin()
        || updateUsuariPreautoritzatValid(uid)
        || (
          autenticat()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rol', 'departament', 'departaments'])
        );
      allow delete: if esAdmin();
    }

    match /pantalles/{screenId} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'name', 'active', 'courseId', 'dateMode',
          'selectedDate', 'theme', 'scale', 'modules', 'views', 'forcedViewId',
          'message', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() <= 20
        && request.resource.data.dateMode in ['today', 'tomorrow', 'specific']
        && request.resource.data.selectedDate is string
        && request.resource.data.theme in ['light', 'dark']
        && request.resource.data.scale is int
        && request.resource.data.scale >= 80
        && request.resource.data.scale <= 140
        && request.resource.data.modules is list
        && request.resource.data.views is list
        && request.resource.data.views.size() > 0
        && request.resource.data.views.size() <= 12
        && request.resource.data.forcedViewId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240
        && request.resource.data.updatedAt == request.time;
      allow delete: if esAdmin();
    }

    match /preautoritzats/{id} {
      allow read: if autenticat() && (id == request.auth.token.email || esAdmin());
      allow write: if esAdmin();
    }

    // ---- Correus de Guàrdies al professorat ---------------------------------------
    // La gestió els posa a la cua (només a adreces del centre) i el servei de correu
    // (Apps Script, amb un compte del centre que té accés al projecte) els envia i en
    // marca l'estat. Les dades no surten de la gestió.
    match /guardiesCorreus/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly([
          'courseId', 'kind', 'template', 'date', 'teacherId', 'email', 'fields',
          'check', 'status', 'reason', 'sendAfter', 'createdAt', 'createdBy'
        ])
        && request.resource.data.courseId is string
        && request.resource.data.kind in ['alliberat', 'pati', 'prova']
        && request.resource.data.template in ['alliberat', 'pati']
        && request.resource.data.status == 'pendent'
        && request.resource.data.email is string
        && request.resource.data.email.matches('[a-z0-9._%+-]+@iesjosepsuredaiblanes[.]com')
        && request.resource.data.fields is map
        && request.resource.data.check is map
        && request.resource.data.sendAfter is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy is string;
      allow delete: if false;
    }

    // ---- Retards (alumnat que arriba tard) -------------------------------------
    // Hi entren l'administració i qui té el rol PSC al professorat de Quota (permís
    // d'accés a «preautoritzats»). Les dades van empaquetades perquè costin poques
    // lectures: un document amb tots els alumnes de cada curs i un amb els retards de
    // cada mes.
    function permisRetards() {
      return preautoritzat(request.auth.token.email);
    }

    function esAdminRetards() {
      return autenticat() && (
        (permisRetards() != null && permisRetards().rol == 'admin')
        || esAdmin()
      );
    }

    function esPscRetards() {
      return autenticat()
        && permisRetards() != null
        && permisRetards().rols is list
        && 'psc' in permisRetards().rols;
    }

    // L'ordre importa: la PSC pot no tenir document a «usuaris» (mai no ha entrat a Quota).
    function potRetards() {
      return esPscRetards() || esAdminRetards();
    }

    match /retardsAlumnes/{schoolYear} {
      allow read: if potRetards();
      allow write: if esAdminRetards()
        && request.resource.data.keys().hasOnly(['schoolYear', 'students', 'updatedAt', 'updatedBy'])
        && request.resource.data.students is list;
    }

    match /retardsMesos/{mesId} {
      allow read: if potRetards();
      allow create, update: if potRetards()
        && request.resource.data.keys().hasOnly(['schoolYear', 'month', 'records', 'updatedAt', 'updatedBy'])
        && request.resource.data.records is list;
      allow delete: if esAdminRetards();
    }

    // Config global antiga: només lectura administrativa per migracions puntuals.
    match /config/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Presencia global antiga: tancada.
    match /presence/{id} {
      allow read, write: if false;
    }
  }
}
